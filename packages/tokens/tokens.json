{
  "$comment": "MediStock design tokens v1. Source of truth for web (CSS variables) and mobile (theme object). Keep names identical across platforms.",
  "color": {
    "light": {
      "ink": "#10262B", "ink-2": "#4A6268", "ink-3": "#7C9095",
      "paper": "#F4F7F6", "surface": "#FFFFFF", "surface-2": "#EBF1F0", "line": "#D5E0DD",
      "brand": "#0B6E64", "brand-strong": "#07524A", "brand-tint": "#DCEFEB", "on-brand": "#FFFFFF",
      "info": "#4457C9", "info-tint": "#E5E8FA",
      "expired": "#B42238", "expired-tint": "#FBE3E6",
      "critical": "#C2410C", "critical-tint": "#FDE9DD",
      "soon": "#9A6A0B", "soon-tint": "#FAF0D7",
      "ok": "#1A7F4E", "ok-tint": "#DEF2E6",
      "focus": "#4457C9"
    },
    "dark": {
      "ink": "#E3EDEB", "ink-2": "#A6BAB6", "ink-3": "#78908B",
      "paper": "#0B1618", "surface": "#112023", "surface-2": "#172A2E", "line": "#23383C",
      "brand": "#3CC4B1", "brand-strong": "#74DACB", "brand-tint": "#123A35", "on-brand": "#062420",
      "info": "#93A2FF", "info-tint": "#1D2346",
      "expired": "#FF7A8C", "expired-tint": "#3B1820",
      "critical": "#FF9157", "critical-tint": "#3A2214",
      "soon": "#F0BC52", "soon-tint": "#352A12",
      "ok": "#5AD394", "ok-tint": "#12321F",
      "focus": "#93A2FF"
    }
  },
  "expiryBands": [
    { "key": "expired",  "label": "Expired",        "rule": "days_left < 0" },
    { "key": "critical", "label": "Expires ≤ 30d",  "rule": "0 <= days_left <= 30" },
    { "key": "soon",     "label": "Expires 31–90d", "rule": "31 <= days_left <= 90" },
    { "key": "ok",       "label": "In date",        "rule": "days_left > 90" }
  ],
  "font": {
    "display": "'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif",
    "body": "'Instrument Sans', 'Segoe UI', system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace"
  },
  "fontSize": { "xs": 12, "sm": 13, "base": 15, "md": 17, "lg": 20, "xl": 24, "2xl": 32, "3xl": 44 },
  "lineHeight": { "tight": 1.15, "snug": 1.3, "body": 1.55 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "sm": 6, "md": 10, "lg": 16, "pill": 999 },
  "shadow": {
    "raised": "0 1px 2px rgba(16,38,43,.06), 0 2px 8px rgba(16,38,43,.05)",
    "overlay": "0 12px 32px rgba(16,38,43,.18)"
  },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(.2,.7,.2,1)" },
  "layout": { "sidebar": 248, "topbar": 60, "contentMax": 1320, "mobileTabBar": 64, "touchTarget": 44 }
}
